# Nobaj Server Configuration

# General
APP_NAME=Nobaj
DEBUG=false
# Required for the private analytics dashboard at /admin.
# Generate one with: openssl rand -hex 32
ADMIN_TOKEN=

# Optional: leave blank until Google AdSense approves the site
GOOGLE_ADSENSE_CLIENT=
GOOGLE_ADSENSE_SLOT_TOP=
GOOGLE_ADSENSE_SLOT_BOTTOM=

# Server Binding
HOST=0.0.0.0
PORT=8000

# File Upload & Media Duration Limits
MAX_UPLOAD_SIZE_MB=500
MAX_DURATION_SECONDS=1800

# Concurrency & Queue System
MAX_CONCURRENT_JOBS=2
MAX_QUEUE_SIZE=50

# Automated Cleanup
FILE_TTL_MINUTES=30
CLEANUP_INTERVAL_MINUTES=5

# Hardware Acceleration (Set to true to use NVENC/QSV/VAAPI if available)
ENABLE_GPU=true
